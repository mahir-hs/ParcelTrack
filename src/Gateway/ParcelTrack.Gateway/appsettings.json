{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "shipment-route": {
        "ClusterId": "shipment-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/v1/shipments/{**catch-all}"
        }
      },
      "tracking-route": {
        "ClusterId": "shipment-cluster",
        "Match": {
          "Path": "/v1/track/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "shipment-cluster": {
        "Destinations": {
          "shipment-api": {
            "Address": "http://localhost:5068"
          }
        }
      }
    }
  }
}
