{
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=parceltrack_notification;Username=postgres;Password=admin"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification-service",
      "Topics": ["shipment.status.changed"]
    }
  },
  "Notification": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "From": "no-reply@parceltrack.dev"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Confluent": "Warning"
    }
  }
}
