{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "webhook-dispatch-service",
      "Topics": ["shipment.created", "shipment.status.changed"]
    }
  },
  "Webhooks": {
    "Subscriptions": [
      {
        "Name": "Acme ERP",
        "Url": "http://localhost:5001/hooks/shipment",
        "Events": ["shipment.created", "shipment.status.changed"]
      },
      {
        "Name": "Partner Analytics",
        "Url": "http://localhost:5002/hooks/events",
        "Events": ["shipment.status.changed"]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Confluent": "Warning"
    }
  }
}
