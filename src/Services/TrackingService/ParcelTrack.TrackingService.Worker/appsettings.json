{
  "ConnectionStrings": {
    "TrackingDb": "Host=localhost;Port=5432;Database=parceltrack_tracking;Username=postgres;Password=admin"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "tracking-service",
      "Topics": ["shipment.created", "shipment.status.changed"]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Confluent": "Warning"
    }
  }
}
