# ParcelTrack — environment configuration
#
# Copy this file to `.env` at the repo root and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored — never commit it.
# All variables below are consumed by docker-compose.yml.

# ── Redis ─────────────────────────────────────────────
# Used for idempotency keys. Any non-empty string works locally.
REDIS_PASSWORD=changeme_redis

# ── PostgreSQL ────────────────────────────────────────
# Points at your NATIVE Postgres install, not a container.
# Containers reach it via host.docker.internal.
# Must match the credentials of the user owning the parceltrack_* databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres

# ── Keycloak ──────────────────────────────────────────
# Admin console login at http://localhost:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak

# ── Kafka ─────────────────────────────────────────────
# KRaft requires a unique base64 cluster ID. Generate one with:
#     docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid
# Changing this after first boot invalidates existing Kafka data.
KAFKA_CLUSTER_ID=replace_with_generated_uuid

# ── SMTP (optional) ───────────────────────────────────
# NotificationService logs emails to the console when these are unset,
# so local development works fine without a real mail server.
# For testing real delivery, Mailtrap or MailHog work well.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@parceltrack.io
